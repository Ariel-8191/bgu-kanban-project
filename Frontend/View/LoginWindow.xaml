<Window x:Class="Frontend.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.View"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Kanban - Login" Width="420"
        SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
            RenderOptions.ClearTypeHint="Enabled" TextOptions.TextFormattingMode="Display">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Height="40"
                                      RenderOptions.ClearTypeHint="Enabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="14,0,0,0">
                        <materialDesign:PackIcon Kind="ViewDashboardOutline"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Kanban" VerticalAlignment="Center" FontWeight="Medium" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowCaptionButton}" Click="Minimize_Click"
                                ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click"
                                ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" />
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:ColorZone>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="24">
                <materialDesign:Card Padding="28" VerticalAlignment="Center"
                                     materialDesign:ElevationAssist.Elevation="Dp4"
                                     RenderOptions.ClearTypeHint="Enabled"
                                     UniformCornerRadius="10">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="48" Height="48"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        <TextBlock Text="Kanban" Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   HorizontalAlignment="Center" Margin="0,8,0,2" />
                        <TextBlock Text="Log in or create an account"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,24" />

                        <TextBox x:Name="EmailBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Email"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Margin="0,0,0,18"
                                 Text="{Binding Path=Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     materialDesign:HintAssist.Hint="Password"
                                     Margin="0,0,0,8" />

                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ValidationErrorBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" MinHeight="20"
                                   Margin="0,4,0,12"
                                   Text="{Binding Path=ErrorMessage, Mode=OneWay}" />

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="40" Click="Login_Click" IsDefault="True" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Login" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Log In" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="40" Click="Register_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlus" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Register" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Border>
</Window>
