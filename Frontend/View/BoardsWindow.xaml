<Window x:Class="Frontend.View.BoardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.View"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Kanban - My Boards" Height="580" Width="700" MinHeight="420" MinWidth="520"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid RenderOptions.ClearTypeHint="Enabled" TextOptions.TextFormattingMode="Display">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Height="40"
                                  materialDesign:ElevationAssist.Elevation="Dp4"
                                  RenderOptions.ClearTypeHint="Enabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <materialDesign:PackIcon Kind="ViewDashboardOutline"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Kanban" VerticalAlignment="Center" FontWeight="Medium" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowCaptionButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <materialDesign:PackIcon Kind="WindowMinimize" />
                    </Button>
                    <Button Style="{StaticResource WindowCaptionButton}" Click="MaxRestore_Click" ToolTip="Maximize">
                        <materialDesign:PackIcon x:Name="MaxRestoreIcon" Kind="WindowMaximize" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Close">
                        <materialDesign:PackIcon Kind="WindowClose" />
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Welcome + logout -->
            <Grid Grid.Row="0" Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Text="{Binding Path=WelcomeMessage, Mode=OneWay}" />
                <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Log Out" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Grid.Row="1" Text="My Boards"
                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                       Margin="4,0,0,10" />

            <!-- Boards list -->
            <materialDesign:Card Grid.Row="2" materialDesign:ElevationAssist.Elevation="Dp2"
                                 RenderOptions.ClearTypeHint="Enabled"
                                 UniformCornerRadius="10" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Path=Boards}"
                          SelectedItem="{Binding Path=SelectedBoard, Mode=TwoWay}"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          materialDesign:DataGridAssist.CellPadding="16,10"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="16,10">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Board Name" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClipboardTextOutline" VerticalAlignment="Center"
                                                                 Opacity="0.55" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Path=Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Owner" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountCircleOutline" VerticalAlignment="Center"
                                                                 Opacity="0.55" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Path=Owner}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Delete board" Height="34" Width="34"
                                            Foreground="{DynamicResource ValidationErrorBrush}"
                                            Click="Delete_Click">
                                        <materialDesign:PackIcon Kind="DeleteOutline" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- Create board -->
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="New board name"
                         VerticalAlignment="Center" Margin="0,0,12,0"
                         Text="{Binding Path=NewBoardName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="40" VerticalAlignment="Center"
                        Click="Create_Click" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Create" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Grid.Row="4" Margin="4,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource ValidationErrorBrush}"
                       Text="{Binding Path=ErrorMessage, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
