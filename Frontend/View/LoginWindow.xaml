<Window x:Class="Frontend.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.View"
        mc:Ignorable="d"
        Title="Kanban - Login" Height="320" Width="420"
        WindowStartupLocation="CenterScreen"
        FontSize="14">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Kanban" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="Log in or create an account" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,0,0,20" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="Email:" Grid.Row="0" Grid.Column="0"
                       VerticalAlignment="Center" />
                <TextBox x:Name="EmailBox" Grid.Row="0" Grid.Column="1" Margin="5" Padding="4"
                         Text="{Binding Path=Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Label Content="Password:" Grid.Row="1" Grid.Column="0"
                       VerticalAlignment="Center" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="5" Padding="4" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="🔑 Log In" Width="120" Height="32" Margin="0,0,10,0"
                        Click="Login_Click" IsDefault="True" />
                <Button Content="✚ Register" Width="120" Height="32"
                        Click="Register_Click" />
            </StackPanel>

            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="Red"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Text="{Binding Path=ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Window>
